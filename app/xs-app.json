
{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 15,
  "routes": [
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "purchaserequest-ui/webapp",
      "authenticationType": "xsuaa"
    }
  ]
}
